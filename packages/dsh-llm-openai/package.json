{
  "name": "@dsh-mail-agent/llm-openai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible LLM adapter and four-tier model router for the DSH mail agent",
  "license": "MIT",
  "author": "Michel-Marie Maudet <mmaudet@linagora.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmaudet/dsh-mail-agent.git",
    "directory": "packages/dsh-llm-openai"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "catalog:",
    "eventsource-parser": "catalog:"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-attachment": "catalog:",
    "@deepseek-ai/dsh-brand": "catalog:",
    "@deepseek-ai/dsh-invariants": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-timeout": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
